# ==============================================================================
# Q-SHIELD AI Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your real OpenAI API key:
#   copy .env.example .env     (Windows PowerShell / Command Prompt)
#   cp .env.example .env       (Linux / macOS)
# ==============================================================================

# ==============================================================================
# INSERT YOUR OPENAI API KEY HERE:
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Configurable AI Provider Settings (Optional)
# ------------------------------------------------------------------------------
# Provider: "openai" (default, uses official OpenAI API) or "mock" (offline/unit testing)
QSHIELD_AI_PROVIDER=openai

# Model: "gpt-4o-mini" (default recommended for speed and cryptographic reasoning),
# or "gpt-4o", "gpt-3.5-turbo", etc.
QSHIELD_AI_MODEL=gpt-4o-mini

# Base API URL: default is official OpenAI endpoint; can be pointed to Azure OpenAI,
# an enterprise proxy, or local OpenAI-compatible inference servers (e.g. vLLM / Ollama)
QSHIELD_AI_BASE_URL=https://api.openai.com/v1

# AI request timeout in seconds (default: 30)
QSHIELD_AI_TIMEOUT=30
